{
  "name": "blankslate",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Tablet HID WebSocket service + Lit visualizer using OpenTabletDriver configurations.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx node/src/cli.ts",
    "udev": "tsx node/src/udev.ts",
    "test": "vitest run --config node/vitest.config.ts",
    "test:watch": "vitest --config node/vitest.config.ts",
    "build:server": "tsc -p node/tsconfig.json",
    "typecheck:server": "tsc -p node/tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "lit": "^3.3.1",
    "node-hid": "^3.3.0",
    "usb": "^3.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "~5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
