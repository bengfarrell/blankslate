{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["w3c-web-hid"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "*.config.ts", "src/cli/**/*"]
}